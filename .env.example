# ==============================================================================
# PAIMANA PREDICT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (PostgreSQL / Relational Store)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paimana_predict
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paimana_predict

# ML Inference & Service Layer
ML_SERVICE_URL=http://localhost:8000
ML_INFERENCE_TIMEOUT_MS=5000

# Logging & Observability
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Data Ingestion Storage Paths
DATA_STORAGE_PATH=./data
SNAPSHOTS_STORAGE_PATH=./data/snapshots
METADATA_STORAGE_PATH=./data/metadata
